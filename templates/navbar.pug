header.docs-topbar.navbar.navbar-expand-lg.sticky-top
  .container-fluid.px-3
    unless hide_sidebar
      button.btn.btn-outline-secondary.btn-sm.d-lg-none.me-2(type="button" data-bs-toggle="offcanvas" data-bs-target="#docsSidebarOffcanvas" aria-controls="docsSidebarOffcanvas" aria-label="Open navigation")
        i.bi.bi-list
    a.docs-brand.navbar-brand.mb-0(href="/")
      img.docs-brand-logo(src=`/docs/assets/jxp-logo.svg?v=${version}` alt="" width="28" height="28")
      span= name
    span.badge.docs-version-badge.ms-2.align-self-center v#{version}
    .ms-auto.d-flex.align-items-center.gap-2.flex-wrap
      if docs_access === 'protected' && !docs_authenticated
        a.btn.btn-sm.btn-outline-light.docs-btn-secondary(href="/docs/login?next=/docs/api") Login
      if docs_access !== 'disabled' && (docs_access !== 'protected' || docs_authenticated)
        .docs-api-key-wrap
          label.visually-hidden(for="docs-api-key") API Key
          input#docs-api-key.form-control.form-control-sm(
            type="password"
            placeholder=docs_access === 'protected' ? "X-API-Key" : "X-API-Key (optional)"
            autocomplete="off"
          )
        .form-check.form-check-inline.mb-0.docs-security-note
          input#docs-remember-key.form-check-input(type="checkbox")
          label.form-check-label(for="docs-remember-key") Remember
        if docs_access === 'protected' && docs_authenticated
          .dropdown
            button#docs-account-menu.btn.btn-sm.btn-outline-secondary.docs-btn-ghost.dropdown-toggle(
              type="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            )
              i.bi.bi-person-circle.me-1
              span.docs-account-label= docs_session_email || 'Account'
            ul.dropdown-menu.dropdown-menu-end.docs-account-menu(aria-labelledby="docs-account-menu")
              if docs_session_email
                li
                  h6.dropdown-header= docs_session_email
              li
                a.dropdown-item(href="/docs/account/settings")
                  i.bi.bi-gear.me-2
                  | Settings
              li
                a.dropdown-item(href="/docs/account/keys")
                  i.bi.bi-key.me-2
                  | API Keys
              li
                hr.dropdown-divider
              li
                form(method="post" action="/docs/logout")
                  button.dropdown-item.docs-signout(type="submit")
                    i.bi.bi-box-arrow-right.me-2
                    | Sign Out
        else if docs_access !== 'protected'
          span.docs-security-note.text-muted.d-none.d-md-inline Dev only
