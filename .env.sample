# Server
PORT=4001
NODE_DOCKER_PORT=4001
API_URL=http://localhost:4001
# API_SERVER=http://localhost:4001

# MongoDB — use MONGO_CONNECTION_STRING or individual MONGODB_* vars
MONGO_CONNECTION_STRING=mongodb://127.0.0.1:27017/jxp
# MONGODB_HOST=127.0.0.1
# MONGODB_PORT=27017
# MONGODB_NAME=jxp
# MONGODB_USER=
# MONGODB_PASSWORD=
# MONGODB_AUTH_DB=admin
# MONGO_OPTIONS={"maxPoolSize":50}

# Auth / tokens
# SHARED_SECRET is also used to encrypt TOTP secrets and sign MFA / WebAuthn challenge JWTs
SHARED_SECRET=change-me
APIKEY_PEPPER=replace-with-a-long-random-secret
BCRYPT_ROUNDS=12
TOKEN_EXPIRY=86400
REFRESH_TOKEN_EXPIRY=2678400
SETUP_TOKEN=replace-with-a-bootstrap-token
SMTP_TLS_VERIFY=true

# Paths
MODEL_DIR=./dist/models
LOG_FILE=access.log

# Built-in jxp models (user, apikey, token, etc.) load from package when missing from MODEL_DIR
# JXP_BUILTIN_MODELS=default
# JXP_BUILTIN_MODELS=none

# API docs browser: protected (default) | disabled | public
# Protected: home + guides public; /docs/api and /docs/model/* need POST /docs/session
# DOCS_ACCESS=protected
# DOCS_USER_EMAIL=docs@example.com
# DOCS_COOKIE_SECURE=true
# APIKEY_LEGACY_DUAL_RUN=false

# Login brute-force protection (default on): POST /login, /docs/session, MFA + passkey endpoints
# LOGIN_RATE_LIMIT_ENABLED=true
# LOGIN_RATE_BURST=8
# LOGIN_RATE_PER_MINUTE=12
# LOGIN_RATE_LIMIT_XFF=true

# MFA (TOTP) + passkeys (WebAuthn) — see docs/authentication.md
# MFA_TOTP_ISSUER=JXP
# MFA_CHALLENGE_TTL=5m
# WEBAUTHN_RP_NAME=JXP
# Hostname only (defaults to host of API_URL)
# WEBAUTHN_RP_ID=localhost
# Comma-separated page origins allowed for registration/login (defaults to API_URL)
# WEBAUTHN_ORIGINS=http://localhost:4001,http://127.0.0.1:4001

# Index diagnostics (see docs/index_diagnostics.md)
# INDEX_DIAGNOSTICS_ENABLED=false
# QUERY_INDEX_MONITOR=true
# QUERY_INDEX_SAMPLE_RATE=1.0
# QUERY_INDEX_MIN_DOCS_EXAMINED=20
# QUERY_INDEX_DOCS_EXAMINED_RATIO=5
# QUERY_INDEX_SMALL_COLLECTION_THRESHOLD=500
# QUERY_INDEX_BUFFER_SIZE=200
# INDEX_QUERY_LOG_RETENTION_DAYS=30

# MCP (Model Context Protocol) — read-only AI tools on the same port as the API
# MCP_ENABLED=false
# MCP_PATH=/mcp
# MCP_REQUIRE_API_KEY=true
# MCP_MODEL_WHITELIST=user
# MCP_MODEL_BLACKLIST=logs,hits
# MCP_DEFAULT_LIMIT=20
# MCP_MAX_LIMIT=100
# MCP_MAX_RESPONSE_SIZE=256kb
# MCP_MAX_CSV_SIZE=512kb
# MCP_TRUNCATE_STRINGS_AT=4000
# MCP_DISABLE_AUTOPOPULATE=true
# MCP_INSTRUCTIONS_APPEND=
# MCP_GUIDE_FILES=./mcp/guide.md
# Bridge (jxp-mcp bin): JXP_URL=http://localhost:4001, JXP_API_KEY=

# Optional
# APIKEY=
# DEBUG=false
# CACHE_ENABLED=false
# CACHE_DEBUG=false
# CACHE_TTL=300
# QUERY_LIMITS_ENABLED=true
# QUERY_LIMITS_MAX=1000
# QUERY_LIMITS_DEFAULT=100
# QUERY_LIMITS_LARGE_COLLECTION_THRESHOLD=10000
# QUERY_LIMITS_REQUIRE_LIMIT_ALWAYS=true
# QUERY_LIMITS_SKIP_COUNT_UNLESS_PAGINATED=true
# QUERY_LIMITS_MAX_RESPONSE_SIZE=10mb
# SECURITY_STRIP_FIELDS=password,temp_hash,key_hash,access_token,refresh_token,apikey,totp_secret_enc,totp_pending_secret_enc,totp_backup_hashes
# THROTTLE_JSON={"burst":100,"rate":50,"ip":true}
# CORS_ORIGINS=http://localhost:3000,http://localhost:4001
