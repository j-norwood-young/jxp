extends layout

block content
  .docs-landing
    section.docs-landing-hero
      .docs-landing-hero-inner
        .docs-landing-mark(aria-hidden="true")
          img(src=`/docs/assets/jxp-logo.svg?v=${version}` alt="" width="56" height="56")
        p.docs-landing-eyebrow
          | powered by
          a(href="https://jxp.readthedocs.io" target="_blank" rel="noopener") JXP
        h1.docs-landing-brand= name
        p.docs-landing-lead
          | Define Mongoose schemas, get a full REST API with auth, permissions, and smart queries.
        .docs-landing-ctas
          if first_guide_url
            a.btn.btn-warning.docs-btn-primary(href=first_guide_url) Documentation
          if docs_access === 'protected' && !docs_authenticated
            a.btn.btn-outline-light.docs-btn-secondary(href="/docs/login?next=/docs/api") Login
          else
            a.btn.btn-outline-light.docs-btn-secondary(href="/docs/api") Browse API
            if mcp_enabled
              a.btn.btn-outline-secondary.docs-btn-ghost(href="/docs/mcp")
                i.bi.bi-robot.me-1
                | Ask MCP

    section.docs-landing-panels
      article.docs-term-panel
        header.docs-term-panel-header
          span.docs-term-dots(aria-hidden="true")
            span
            span
            span
          h2 Quick start
        .docs-term-panel-body
          p Authenticate with an API key header#{docs_access === 'public' ? ' (optional for exploring docs; required for live calls)' : ''}:
          pre.docs-term-code
            code.
              curl -H "X-API-Key: YOUR_KEY" \
                "#{base_url}/api/MODEL?limit=5"
          p.docs-term-note
            if docs_access === 'protected'
              | After signing in, your API key is filled in automatically for 
              strong Try it 
              |  panels on API resource pages.
            else
              | Set your key in the top bar to use 
              strong Try it 
              |  panels on API resource pages. Keys are stored in the browser only when “Remember” is checked.

      article.docs-term-panel
        header.docs-term-panel-header
          span.docs-term-dots(aria-hidden="true")
            span
            span
            span
          h2
            if mcp_enabled
              | MCP for AI agents
            else
              | MCP (Model Context Protocol)
        .docs-term-panel-body
          if mcp_enabled
            p
              | This server exposes read-only MCP tools at 
              code= mcp_path
              |  — use them from Cursor, LM Studio, or the built-in assistant.
            pre.docs-term-code
              code.
                MCP_ENABLED=true
                # Cursor: npx -y jxp-mcp
            .docs-term-actions
              if docs_authenticated || docs_access !== 'protected'
                a.btn.btn-sm.btn-warning.docs-btn-primary(href="/docs/mcp") Open MCP assistant
              a.btn.btn-sm.btn-outline-secondary.docs-btn-ghost(href="/docs/md/mcp.md") Setup guide
          else
            p
              | Enable 
              code MCP_ENABLED=true 
              |  to expose five fixed read-only tools (
              code jxp_list_models
              | , 
              code jxp_find
              | , …) for AI clients and a built-in docs playground.
            a.btn.btn-sm.btn-outline-light.docs-btn-secondary(href="/docs/md/mcp.md") Read MCP docs

    if docs_authenticated || docs_access !== 'protected'
      section.docs-landing-glance
        h2 API at a glance
        p.docs-landing-glance-count
          strong= model_list.length
          |  resource#{model_list.length !== 1 ? 's' : ''} registered
        if model_list.length
          .docs-landing-badges
            each m in model_list.slice(0, 12)
              a.docs-model-badge(href="/docs/model/" + m)= m
            if model_list.length > 12
              a.docs-model-badge.docs-model-badge-more(href="/docs/api") +#{model_list.length - 12} more
        else
          p.docs-muted No models loaded yet.

    section.docs-landing-features
      h2 Features
      .docs-feature-grid
        each feature in features
          article.docs-feature
            h3= feature.title
            p= feature.description

    section.docs-landing-links
      h2 Links
      ul
        li
          a(href="https://www.npmjs.com/package/jxp" target="_blank" rel="noopener") JXP on NPM
        li
          a(href="https://github.com/WorkSpaceMan/jxp" target="_blank" rel="noopener") GitHub
        li
          a(href="https://www.npmjs.com/package/jxp-helper" target="_blank" rel="noopener") jxp-helper client
        li
          a(href="https://jxp.readthedocs.io" target="_blank" rel="noopener") Read the Docs
